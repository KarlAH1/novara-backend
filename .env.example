# =====================================================================
# Raisium backend: miljøvariabler
#
# Lokalt: kopier til backend/.env.local og fyll inn.
# Produksjon: sett verdiene som Environment Variables på Render.
# Aldri commit ekte verdier.
# =====================================================================

# --- Kjøremiljø -------------------------------------------------------
# MÅ være "production" på Render. Uten den er CORS åpen for dev-opphav,
# proxy-IP-er stoles ikke på, og sjekkene av JWT-nøkkel og e-post kjøres ikke.
NODE_ENV=production
PORT=8080

# --- Database (Aiven MySQL i prod, 127.0.0.1 lokalt) -------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=novara_local
DB_SSL=false

# --- Innlogging --------------------------------------------------------
# Minst 32 tilfeldige tegn. Lag en med:  openssl rand -hex 32
# Prod nekter å starte med en kort verdi eller en plassholder.
JWT_SECRET=
# Tokens uten issuer/audience (før 2026-09-08) avvises. Ikke slå på igjen.
ALLOW_LEGACY_JWT=false

# Krypterer investorers fødselsnummer. Egen nøkkel, aldri lik JWT_SECRET.
# Lag en med:  openssl rand -hex 32
# NB: bytter du denne i prod, kan allerede lagrede fødselsnumre ikke dekrypteres.
NATIONAL_ID_ENCRYPTION_KEY=

# --- Frontend og CORS --------------------------------------------------
# Kommaseparert liste over tillatte opphav, f.eks.
# https://raisium.io,https://www.raisium.io
FRONTEND_URL=http://localhost:5500/frontend

# --- E-post (Resend) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Raisium <notifications@mail.raisium.io>

# --- Stripe (live-nøkler kun i prod) ------------------------------------
# Se STRIPE_PRODUCTION_CHECKLIST.md
STRIPE_SECRET_KEY=
# Endepunktet for Raisiums egen konto (planbetaling)
STRIPE_WEBHOOK_SECRET=
# Endepunktet for tilkoblede kontoer (RC-investeringer og paribeløp). Uten denne bekreftes ingen investorbetaling.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- OpenAI (forslag til pitch og tolkning av vedtekter) ---------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Interne varsler (valgfritt) ----------------------------------------
# Varslene inneholder ikke navn, e-post eller fritekst.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Manuell planbetaling (valgfritt; standardverdier finnes i koden) ---
RAISIUM_PAYMENT_RECIPIENT=Raisium AS
RAISIUM_BANK_ACCOUNT=
